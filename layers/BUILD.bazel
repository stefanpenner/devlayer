# Layers: read-only EROFS images, one per concern, mounted by content hash.
#
#   runtime  what a node boots: /init, OpenSSH (LibreSSL libcrypto),
#            node-identity (the TPM host key), a small toybox. No compilers,
#            no language runtimes, no git. The SER9 image is this layer only.
#   dev      the full devlayer Linux sysroot. Step 2 of the layering plan; for
#            now tests attach it as an extra disk at /layers/dev.
#
#   bazel build //layers:runtime //layers:dev
#
# Builds need a Linux x86_64 exec host, like //node:kernel. See node/README.md.

load(":defs.bzl", "RUNTIME_OPENSSH", "RUNTIME_TOYBOX")

package(default_visibility = ["//visibility:public"])

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

_MKIMAGE = [
    "$(location //node/tools/mkimage)",
    "-out $@",
    "-mkfs $(location @node_hosttools_linux_x86_64//:usr/bin/mkfs.erofs)",
    "-loader $(location @node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1)",
    "-libpath $$(dirname $(location @node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1)):$$(dirname $(location @node_hosttools_linux_x86_64//:usr/bin/mkfs.erofs))/../lib",
]

_MKIMAGE_SRCS = [
    "@node_hosttools_linux_x86_64//:all",
    "@node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1",
    "@node_hosttools_linux_x86_64//:usr/bin/mkfs.erofs",
]

# OpenSSH portable on LibreSSL's libcrypto: static musl, by the pinned zig.
_OPENSSH = ["sshd", "sshd-session", "sshd-auth", "ssh", "ssh-keygen"]

genrule(
    name = "openssh",
    srcs = [
        "@libressl_src//:all_srcs",
        "@libressl_src//:configure",
        "@openssh_src//:all_srcs",
        "@openssh_src//:configure",
        "@node_hosttools_linux_x86_64//:all",
        "@node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1",
        "@zig_linux_amd64//:all",
        "@zig_linux_amd64//:zig",
    ],
    outs = ["openssh/" + b for b in _OPENSSH],
    cmd = " ".join([
        "OPENSSH_SRC=$$(dirname $(location @openssh_src//:configure))",
        "LIBRESSL_SRC=$$(dirname $(location @libressl_src//:configure))",
        "ZIG=$(location @zig_linux_amd64//:zig)",
        "HOST_ROOT=$$(dirname $$(dirname $(location @node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1)))",
        "OUT_DIR=$(RULEDIR)/openssh",
        "sh $(location openssh.sh)",
    ]),
    target_compatible_with = _LINUX_X86_64,
    tools = ["openssh.sh"],
)

# Single-file names for the test payloads.
[alias(
    name = b,
    actual = "openssh/" + b,
) for b in _OPENSSH]

# toybox: devlayer's toolbox build (macos/toolbox.sh) with the runtime applets.
genrule(
    name = "toybox",
    srcs = [
        "toybox.miniconfig",
        "@toybox_src//:all_srcs",
        "@zig_linux_amd64//:all",
        "@zig_linux_amd64//:zig",
        "@kernel_llvm_linux_amd64//:bin/llvm-strip",
    ],
    outs = ["toybox.bin"],
    cmd = " ".join([
        "A=; for f in $(locations @toybox_src//:all_srcs); do case $$f in */configure)",
        "if [ -z \"$$A\" ] || [ $${#f} -lt $${#A} ]; then A=$$f; fi;; esac; done;",
        "T=$$(mktemp -d);",
        "sh $(location //macos:toolbox.sh) $$T/out $(location @zig_linux_amd64//:zig)",
        "$(location toybox.miniconfig) $$A $(location toybox.miniconfig) >&2 &&",
        "$(location @kernel_llvm_linux_amd64//:bin/llvm-strip) -o $@ $$T/out/toybox &&",
        "rm -rf $$T",
    ]),
    target_compatible_with = _LINUX_X86_64,
    tools = ["//macos:toolbox.sh"],
)

# The runtime layer. The node's whole root filesystem.
genrule(
    name = "runtime",
    srcs = _MKIMAGE_SRCS + [
        ":openssh",
        ":sshd",
        ":sshd-session",
        ":sshd-auth",
        ":toybox",
        "//node:init",
        "//node/identity",
        "//node/agent",
        "runtime/etc/ssh/sshd_config",
        "runtime/etc/ssh/trusted_user_ca_keys",
        "runtime/etc/passwd",
        "runtime/etc/group",
        "@stefanpenner_keys//file",
    ],
    outs = ["runtime.erofs"],
    cmd = " ".join(_MKIMAGE + [
        "-file sbin/init=$(location //node:init)",
        "-link sbin/node-layer=init",
        "-file sbin/node-identity=$(location //node/identity)",
        "-file sbin/node-agent=$(location //node/agent)",
        "-file etc/ssh/sshd_config=$(location runtime/etc/ssh/sshd_config)",
        "-file etc/ssh/trusted_user_ca_keys=$(location runtime/etc/ssh/trusted_user_ca_keys)",
        "-file bin/toybox=$(location :toybox)",
        "-file etc/passwd=$(location runtime/etc/passwd)",
        "-file etc/group=$(location runtime/etc/group)",
        "-file root/.ssh/authorized_keys=$(location @stefanpenner_keys//file)",
    ] + ["-link bin/%s=toybox" % a for a in RUNTIME_TOYBOX] + [
        "-file %s=$(location :%s)" % (k, v)
        for k, v in RUNTIME_OPENSSH.items()
    ] + [
        "-dir dev -dir proc -dir sys -dir run -dir tmp -dir var -dir etc/node",
        "-dir etc/ssh/sshd_config.d -dir var/empty -dir test -dir layers/.by-hash",
        "-mode root=0700 -mode root/.ssh=0700 -mode root/.ssh/authorized_keys=0600",
        "-z lz4hc",
    ]),
    target_compatible_with = _LINUX_X86_64,
    tools = ["//node/tools/mkimage"],
)

# The dev layer: the full devlayer Linux sysroot as one EROFS. Mounted at
# /layers/dev, its wrappers find their tools relative to themselves.
genrule(
    name = "dev",
    srcs = _MKIMAGE_SRCS + ["//linux:bundle_x86_64"],
    outs = ["dev.erofs"],
    cmd = " ".join(_MKIMAGE + [
        "-tar $(location //linux:bundle_x86_64)",
        "-dedupe -z lz4hc",
    ]),
    target_compatible_with = _LINUX_X86_64,
    tools = ["//node/tools/mkimage"],
)
