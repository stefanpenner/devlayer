# Runtime layer userland: a shell for SSH sessions and devlayer push, and
# the few tools a person needs to look at a node. Nothing else.
CONFIG_SH=y
CONFIG_CD=y
CONFIG_EXIT=y
CONFIG_SET=y
CONFIG_UNSET=y
CONFIG_EVAL=y
CONFIG_EXEC=y
CONFIG_EXPORT=y
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CP=y
CONFIG_DF=y
CONFIG_DMESG=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_FREE=y
CONFIG_ID=y
CONFIG_IFCONFIG=y
CONFIG_KILL=y
CONFIG_LN=y
CONFIG_LOSETUP=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MOUNT=y
CONFIG_MOUNTPOINT=y
CONFIG_MV=y
CONFIG_PRINTF=y
CONFIG_PS=y
CONFIG_REBOOT=y
CONFIG_RM=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
CONFIG_SLEEP=y
CONFIG_SYNC=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_UMOUNT=y
CONFIG_UNAME=y
CONFIG_UPTIME=y
