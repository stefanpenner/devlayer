load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

exports_files(
    [
        "HERMETICITY.md",
        "versions.env",
        ".bazelrc",
    ],
    visibility = ["//visibility:public"],
)

gazelle(
    name = "gazelle",
    prefix = "github.com/stefanpenner/devlayer",
)

go_library(
    name = "devlayer_lib",
    srcs = ["main.go"],
    embedsrcs = [
        "versions.env",
        "config/nvim/nvim-pack-lock.json",
        "//third_party/ncurses:aliases.ti",
        "//third_party/ncurses:configure.sh",
        "//third_party/ncurses:fallbacks.txt",
        "//third_party/patches:unibilium_no_host.patch",
    ],
    importpath = "github.com/stefanpenner/devlayer",
    visibility = ["//visibility:private"],
    deps = [
        "//cmd",
        "//internal/versions",
    ],
)

# Do not add the netgo tag when this binary targets darwin.
# Darwin keeps the Apple resolver in libresolv.
# The Go resolver does not do mDNS, so a .local name fails.
# A name that exists only in the macOS resolver can fail.
# Darwin can show a dialog when a program sends its own DNS query.
go_binary(
    name = "devlayer",
    embed = [":devlayer_lib"],
    visibility = ["//visibility:public"],
    x_defs = {"main.Version": "{STABLE_VERSION}"},
)
