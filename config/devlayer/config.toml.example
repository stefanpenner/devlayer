[dotfiles]
sync = [
  # shell
  ".bash_profile",
  ".zshrc",
  ".config/zsh",
  ".p10k.zsh",

  # terminal + editor
  ".config/ghostty",
  ".config/nvim",
  ".config/opencode",
  ".gitconfig",

  # optional SSH layer: config only, never private keys
  ".ssh/config",
  ".ssh/config.d",
]
# House tools: a local ~/.config/devlayer/private.toml with [private] repo and path.
# build skips that layer when the file is absent. Do not commit the file.
