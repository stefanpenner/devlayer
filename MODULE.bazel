module(
    name = "devlayer",
    version = "0.0.0",
)

# ─── Go ──────────────────────────────────────────────────────────────────────
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.47.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_burntsushi_toml",
    "com_github_charmbracelet_lipgloss",
    "com_github_ulikunitz_xz",
)

# ─── Hermetic C/C++ toolchain (zig-based) ───────────────────────────────────
# The patch pins Zig 0.16.0 and updates the wrapper for that release.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
single_version_override(
    module_name = "hermetic_cc_toolchain",
    patch_strip = 1,
    patches = ["//third_party/patches:hermetic_cc_zig_0_16.patch"],
)

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
toolchains.exec_platform(
    arch = "amd64",
    os = "linux",
)
toolchains.exec_platform(
    arch = "arm64",
    os = "linux",
)
toolchains.exec_platform(
    arch = "amd64",
    os = "macos",
)
toolchains.exec_platform(
    arch = "arm64",
    os = "macos",
)
use_repo(toolchains, "zig_sdk")

macos_sdk = use_repo_rule("//tools:macos_sdk.bzl", "macos_sdk")

macos_sdk(name = "macos_sdk")

# Hermetic CC is opt-in via .bazelrc configs (--config=linux-x86_64-musl etc.)
# macOS rules pass the pinned SDK to zig cc.
# The global toolchain does not receive that SDK.

# ─── Platforms ───────────────────────────────────────────────────────────────
bazel_dep(name = "platforms", version = "1.0.0")

# ─── Foreign CC (cmake/autotools builds) ────────────────────────────────────
bazel_dep(name = "rules_foreign_cc", version = "0.14.0")

# macOS libSystem glob() does not match GNU glob_t. The stock build.sh links
# the system glob, and $(wildcard) then crashes. The patch force-loads GNU glob.
single_version_override(
    module_name = "rules_foreign_cc",
    patch_strip = 1,
    patches = ["//third_party/patches:foreign_cc_make_glob.patch"],
)

# ─── Versions (single source of truth: versions.env) ───────────────────────
versions = use_extension("//tools:versions_ext.bzl", "versions_ext")
use_repo(versions, "versions")

# ─── Third-party tools (sources, pre-built binaries, shell assets) ─────────
tool_repos = use_extension("//tools:extensions.bzl", "tool_repos")
use_repo(
    tool_repos,
    # Source builds
    "btop_src",
    "git_src",
    "htop_src",
    "libiconv_src",
    "make_src",
    "ncurses_src",
    "nvim_libuv",
    "nvim_lpeg",
    "nvim_lua_compat53",
    "nvim_luajit",
    "nvim_luv",
    "nvim_src",
    "nvim_treesitter",
    "nvim_treesitter_c",
    "nvim_treesitter_lua",
    "nvim_treesitter_markdown",
    "nvim_treesitter_query",
    "nvim_treesitter_vim",
    "nvim_treesitter_vimdoc",
    "nvim_unibilium",
    "nvim_utf8proc",
    "toybox_src",
    "zlib_src",
    "zsh_src",
    # Pre-built Rust tools (per platform)
    "bat_darwin_arm64",
    "bat_linux_amd64",
    "bat_linux_arm64",
    "delta_darwin_arm64",
    "delta_linux_amd64",
    "delta_linux_arm64",
    "dust_darwin_arm64",
    "dust_linux_amd64",
    "dust_linux_arm64",
    "fd_darwin_arm64",
    "fd_linux_amd64",
    "fd_linux_arm64",
    "rg_darwin_arm64",
    "rg_linux_amd64",
    "rg_linux_arm64",
    # Pre-built Go tools (per platform)
    "age_darwin_arm64",
    "age_linux_amd64",
    "age_linux_arm64",
    "fzf_darwin_arm64",
    "fzf_linux_amd64",
    "fzf_linux_arm64",
    "lazygit_darwin_arm64",
    "lazygit_linux_amd64",
    "lazygit_linux_arm64",
    "shh_darwin_arm64",
    "shh_linux_amd64",
    "shh_linux_arm64",
    # Single-binary tools (per platform)
    "direnv_darwin_arm64",
    "direnv_linux_amd64",
    "direnv_linux_arm64",
    "jq_darwin_arm64",
    "jq_linux_amd64",
    "jq_linux_arm64",
    # SDKs / runtimes (per platform)
    "go_sdk_darwin_arm64",
    "go_sdk_linux_amd64",
    "go_sdk_linux_arm64",
    "nvim_darwin_arm64",
    "nvim_linux_amd64",
    "nvim_linux_arm64",
    "zig_darwin_arm64",
    "zig_linux_amd64",
    "zig_linux_arm64",
    # Shell assets
    "bat_extras",
    "fast_syntax_highlighting",
    "fzf_shell",
    "powerlevel10k",
    "zsh_autosuggestions",
    "zsh_history_substring_search",
)

# Rust 1.90.0 and vendored crates. Repo rules run on the Mac.
# Build actions use the outputs. They do not call host cargo.
crate_repos = use_extension("//tools:crates.bzl", "crate_repos")
use_repo(
    crate_repos,
    "bininfo_crates",
    "cratevendor_go",
    "eza_crates",
    "eza_src",
    "rust_aarch64_apple_darwin",
    "rust_aarch64_unknown_linux_musl",
    "rust_x86_64_unknown_linux_musl",
)
