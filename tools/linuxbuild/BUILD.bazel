load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "linuxbuild_lib",
    srcs = ["main.go"],
    importpath = "github.com/stefanpenner/devlayer/tools/linuxbuild",
    visibility = ["//visibility:private"],
    deps = ["//internal/linuxbuild"],
)

go_binary(
    name = "linuxbuild",
    embed = [":linuxbuild_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "linuxbuild_linux_amd64",
    embed = [":linuxbuild_lib"],
    goarch = "amd64",
    goos = "linux",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "linuxbuild_linux_arm64",
    embed = [":linuxbuild_lib"],
    goarch = "arm64",
    goos = "linux",
    visibility = ["//visibility:public"],
)
