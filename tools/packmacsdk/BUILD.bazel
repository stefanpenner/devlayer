load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "packmacsdk_lib",
    srcs = ["main.go"],
    importpath = "github.com/stefanpenner/devlayer/tools/packmacsdk",
    visibility = ["//visibility:private"],
