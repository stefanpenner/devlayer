# Bzlmod is the only dep management in Bazel 9+
build --enable_bzlmod

# Hermetic builds: don't inherit host env
build --incompatible_strict_action_env

# Pure Go — no CGo needed
build --@rules_go//go/config:pure

# Version stamping for go_binary x_defs.
# Windows uses a cmd script: Bazel runs workspace_status_command via
# cmd.exe, and the POSIX script's `git describe --dirty` never returns
# (run 35561178234). Platform config expands in place, so it must follow
# the shell default or the .sh line wins.
build --stamp
build --workspace_status_command=tools/workspace_status.sh
build:windows --workspace_status_command=tools/workspace_status.cmd
build --enable_platform_specific_config

# Platform configs for cross-compilation
build:linux-x86_64 --platforms=@zig_sdk//platform:linux_amd64
build:linux-x86_64-musl --extra_toolchains=@zig_sdk//toolchain:linux_amd64_musl
build:linux-aarch64 --platforms=@zig_sdk//platform:linux_arm64
build:linux-aarch64-musl --extra_toolchains=@zig_sdk//toolchain:linux_arm64_musl
build:darwin-arm64 --platforms=@zig_sdk//platform:darwin_arm64
build:darwin-x86_64 --platforms=@zig_sdk//platform:darwin_amd64

# Go cross-compilation (pure Go, no CGo)
build:go-linux-amd64 --platforms=@rules_go//go/toolchain:linux_amd64
build:go-linux-arm64 --platforms=@rules_go//go/toolchain:linux_arm64
build:go-darwin-arm64 --platforms=@rules_go//go/toolchain:darwin_arm64
build:go-windows-amd64 --platforms=@rules_go//go/toolchain:windows_amd64

# Sealed Linux build. The Mac runs repo rules.
# Actions run on a local Buildbarn worker.
# There is no local fallback and no dynamic strategy.
# An empty RBE_IMAGE fails analysis of //rbe:linux_*.
# codesign stays on the Mac. Do not use this config for that step.
# The worker must use linux-sandbox: private mounts, private PIDs, no NIC.
build:rbe --remote_executor=grpc://127.0.0.1:8980
build:rbe --spawn_strategy=remote
build:rbe --noremote_local_fallback
build:rbe --noincompatible_remote_local_fallback_for_remote_cache
build:rbe --noremote_upload_local_results
build:rbe --extra_execution_platforms=//rbe:linux_arm64,//rbe:linux_amd64
build:rbe --host_platform=//rbe:linux_arm64
build:rbe --platforms=//rbe:linux_arm64
build:rbe --remote_timeout=3600s

# Sensible defaults
build --verbose_failures
test --test_output=errors

# CI writes this before Bazel (see .github/workflows/bazel-ci-cache.sh).
# Absent on developer machines, so local builds keep the default output root.
try-import %workspace%/.bazelrc.ci

# Node VM tests (node/). Boots the node kernel in the pinned QEMU.
# NODE_VM_ACCEL=tcg|kvm|hvf overrides the pick; the client env passes it.
test:node --test_tag_filters=node-vm
test:node --test_env=NODE_VM_ACCEL
