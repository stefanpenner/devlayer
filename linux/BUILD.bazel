# Linux bundle. Each name is written once. Later lines use that value.

load("@versions//:versions.bzl", "VERSIONS")
load(":defs.bzl", "base_image", "bundle", "compile_tool", "container_test", "image")

base = base_image("base_image_x86_64", "x86_64")
sysroot = "sysroot/x86_64-linux-musl.tar.gz"
linuxbuild = "//tools/linuxbuild:linuxbuild_linux_amd64"

git = compile_tool("git_x86_64", "git", "x86_64", {"GIT_VERSION": VERSIONS["GIT"]}, base, sysroot, linuxbuild)
zsh = compile_tool("zsh_x86_64", "zsh", "x86_64", {"ZSH_VERSION": VERSIONS["ZSH"]}, base, sysroot, linuxbuild)
htop = compile_tool("htop_x86_64", "htop", "x86_64", {"HTOP_VERSION": VERSIONS["HTOP"]}, base, sysroot, linuxbuild)
btop = compile_tool("btop_x86_64", "btop", "x86_64", {"BTOP_VERSION": VERSIONS["BTOP"]}, base, sysroot, linuxbuild, "patches/btop-amdgpu-sysfs.patch")
nvim = compile_tool("nvim_x86_64", "nvim", "x86_64", {"NVIM_VERSION": VERSIONS["NVIM"]}, base, sysroot, linuxbuild)
make = compile_tool("make_x86_64", "make", "x86_64", {"MAKE_VERSION": VERSIONS["MAKE"]}, base, sysroot, linuxbuild)

btop_image = image(
    "btop_x86_64_image",
    "x86_64",
    tars = [btop],
    entrypoint = ["/btop"],
)
container_test(
    "btop_x86_64_test",
    btop_image,
    "x86_64",
    cmd = ["--version"],
    expect = "btop",
)

git_image = image(
    "git_x86_64_image",
    "x86_64",
    tars = [git],
    entrypoint = ["/bin/git"],
    env = {"GIT_EXEC_PATH": "/libexec/git-core"},
)
container_test(
    "git_x86_64_test",
    git_image,
    "x86_64",
    cmd = ["--version"],
    expect = "^git version",
)

zsh_image = image(
    "zsh_x86_64_image",
    "x86_64",
    tars = [zsh],
    entrypoint = ["/bin/zsh"],
    env = {"FPATH": "@functions"},
)
container_test(
    "zsh_x86_64_test",
    zsh_image,
    "x86_64",
    cmd = ["-fc", "print smoke-ok"],
    expect = "^smoke-ok$",
)

nvim_image = image(
    "nvim_x86_64_image",
    "x86_64",
    tars = [nvim],
    entrypoint = ["/bin/nvim"],
    env = {"VIMRUNTIME": "/share/nvim/runtime"},
)
container_test(
    "nvim_x86_64_test",
    nvim_image,
    "x86_64",
    cmd = ["--headless", "--version"],
    expect = "^NVIM v",
)

bundle("bundle_x86_64", "x86_64", git, zsh, htop, btop, nvim, make)

