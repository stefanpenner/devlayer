    git,
    "aarch64",
    entry = "/bin/git",
    cmd = ["--version"],
    expect = "^git version",
    env = "GIT_EXEC_PATH=/libexec/git-core",
)
scratch_test(
    "zsh_aarch64_test",
    zsh,
    "aarch64",
    entry = "/bin/zsh",
    cmd = ["-fc", "print smoke-ok"],
    expect = "^smoke-ok$",
    env = "FPATH=@functions",
