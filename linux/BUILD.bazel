# Linux bundle. Each line is one target.
# base_image builds the Alpine compiler image.
# compile_tool runs linuxbuild in that image and writes a tarball.
# scratch_smoke starts that tarball in FROM scratch.
# bundle packs the tarballs with the prebuilt tools.

load("@versions//:versions.bzl", "VERSIONS")
load(":defs.bzl", "base_image", "bundle", "compile_tool", "scratch_smoke")

base_image("x86_64")

compile_tool("git", "x86_64", {"GIT_VERSION": VERSIONS["GIT"]})
compile_tool("zsh", "x86_64", {"ZSH_VERSION": VERSIONS["ZSH"]})
compile_tool("htop", "x86_64", {"HTOP_VERSION": VERSIONS["HTOP"]})
compile_tool("btop", "x86_64", {"BTOP_VERSION": VERSIONS["BTOP"]}, "patches/btop-amdgpu-sysfs.patch")
compile_tool("nvim", "x86_64", {"NVIM_VERSION": VERSIONS["NVIM"]})
compile_tool("make", "x86_64", {"MAKE_VERSION": VERSIONS["MAKE"]})

scratch_smoke("btop", "x86_64", entry = "/btop", cmd = ["--version"], expect = "btop")
scratch_smoke("git", "x86_64", entry = "/bin/git", cmd = ["--version"], expect = "^git version", env = "GIT_EXEC_PATH=/libexec/git-core")
scratch_smoke("zsh", "x86_64", entry = "/bin/zsh", cmd = ["-fc", "print smoke-ok"], expect = "^smoke-ok$", env = "FPATH=@functions")
scratch_smoke("nvim", "x86_64", entry = "/bin/nvim", cmd = ["--headless", "--version"], expect = "^NVIM v", env = "VIMRUNTIME=/share/nvim/runtime")

bundle("x86_64")

base_image("aarch64")

compile_tool("git", "aarch64", {"GIT_VERSION": VERSIONS["GIT"]})
compile_tool("zsh", "aarch64", {"ZSH_VERSION": VERSIONS["ZSH"]})
compile_tool("htop", "aarch64", {"HTOP_VERSION": VERSIONS["HTOP"]})
compile_tool("btop", "aarch64", {"BTOP_VERSION": VERSIONS["BTOP"]}, "patches/btop-amdgpu-sysfs.patch")
compile_tool("nvim", "aarch64", {"NVIM_VERSION": VERSIONS["NVIM"]})
compile_tool("make", "aarch64", {"MAKE_VERSION": VERSIONS["MAKE"]})

scratch_smoke("btop", "aarch64", entry = "/btop", cmd = ["--version"], expect = "btop")
scratch_smoke("git", "aarch64", entry = "/bin/git", cmd = ["--version"], expect = "^git version", env = "GIT_EXEC_PATH=/libexec/git-core")
scratch_smoke("zsh", "aarch64", entry = "/bin/zsh", cmd = ["-fc", "print smoke-ok"], expect = "^smoke-ok$", env = "FPATH=@functions")
scratch_smoke("nvim", "aarch64", entry = "/bin/nvim", cmd = ["--headless", "--version"], expect = "^NVIM v", env = "VIMRUNTIME=/share/nvim/runtime")

bundle("aarch64")
