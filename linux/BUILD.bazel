htop = compile_tool("htop_aarch64", "htop", "aarch64", {"HTOP_VERSION": VERSIONS["HTOP"]}, base, sysroot, linuxbuild)
btop = compile_tool("btop_aarch64", "btop", "aarch64", {"BTOP_VERSION": VERSIONS["BTOP"]}, base, sysroot, linuxbuild, "patches/btop-amdgpu-sysfs.patch")
nvim = compile_tool("nvim_aarch64", "nvim", "aarch64", {"NVIM_VERSION": VERSIONS["NVIM"]}, base, sysroot, linuxbuild)
make = compile_tool("make_aarch64", "make", "aarch64", {"MAKE_VERSION": VERSIONS["MAKE"]}, base, sysroot, linuxbuild)

scratch_test(
