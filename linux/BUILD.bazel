# Linux bundle. x86_64, then aarch64. Each arch spells its own targets.

load("@versions//:versions.bzl", "VERSIONS")
load(":defs.bzl", "base_image", "bundle", "compile_tool", "container_test", "image")

base = base_image(
    name = "base_image_x86_64",
    arch = "x86_64",
)

sysroot = "sysroot/x86_64-linux-musl.tar.gz"

linuxbuild = "//tools/linuxbuild:linuxbuild_linux_amd64"

git = compile_tool(
    name = "git_x86_64",
    tool = "git",
    arch = "x86_64",
    env = {"GIT_VERSION": VERSIONS["GIT"]},
    base = base,
    sysroot = sysroot,
    linuxbuild = linuxbuild,
)

zsh = compile_tool(
    name = "zsh_x86_64",
    tool = "zsh",
    arch = "x86_64",
    env = {"ZSH_VERSION": VERSIONS["ZSH"]},
    base = base,
    sysroot = sysroot,
    linuxbuild = linuxbuild,
)

htop = compile_tool(
    name = "htop_x86_64",
    tool = "htop",
    arch = "x86_64",
    env = {"HTOP_VERSION": VERSIONS["HTOP"]},
    base = base,
    sysroot = sysroot,
    linuxbuild = linuxbuild,
)

btop = compile_tool(
    name = "btop_x86_64",
    tool = "btop",
    arch = "x86_64",
    env = {"BTOP_VERSION": VERSIONS["BTOP"]},
    base = base,
    sysroot = sysroot,
    linuxbuild = linuxbuild,
    patch = "patches/btop-amdgpu-sysfs.patch",
)

nvim = compile_tool(
    name = "nvim_x86_64",
    tool = "nvim",
    arch = "x86_64",
    env = {"NVIM_VERSION": VERSIONS["NVIM"]},
    base = base,
    sysroot = sysroot,
    linuxbuild = linuxbuild,
)

make = compile_tool(
    name = "make_x86_64",
    tool = "make",
    arch = "x86_64",
    env = {"MAKE_VERSION": VERSIONS["MAKE"]},
    base = base,
    sysroot = sysroot,
    linuxbuild = linuxbuild,
)

scratch = image(
    name = "scratch_linux_amd64",
    arch = "x86_64",
)

btop_image = image(
    name = "btop_x86_64_image",
    base = scratch,
    tars = [btop],
    entrypoint = ["/btop"],
)

container_test(
    name = "btop_x86_64_test",
    image = btop_image,
    arch = "x86_64",
    cmd = ["--version"],
    expect = "btop",
)

git_image = image(
    name = "git_x86_64_image",
    base = scratch,
    tars = [git],
    entrypoint = ["/bin/git"],
    env = {"GIT_EXEC_PATH": "/libexec/git-core"},
)

container_test(
    name = "git_x86_64_test",
    image = git_image,
    arch = "x86_64",
    cmd = ["--version"],
    expect = "^git version",
)

zsh_image = image(
    name = "zsh_x86_64_image",
    base = scratch,
    tars = [zsh],
    entrypoint = ["/bin/zsh"],
    env = {
        "FPATH": "/share/zsh/" + VERSIONS["ZSH"] + "/functions",
    },
)

container_test(
    name = "zsh_x86_64_test",
    image = zsh_image,
    arch = "x86_64",
    cmd = ["-fc", "print smoke-ok"],
    expect = "^smoke-ok$",
)

nvim_image = image(
    name = "nvim_x86_64_image",
    base = scratch,
    tars = [nvim],
    entrypoint = ["/bin/nvim"],
    env = {"VIMRUNTIME": "/share/nvim/runtime"},
)

container_test(
    name = "nvim_x86_64_test",
    image = nvim_image,
    arch = "x86_64",
    cmd = ["--headless", "--version"],
    expect = "^NVIM v",
)

bundle(
    name = "bundle_x86_64",
    arch = "x86_64",
    git = git,
    zsh = zsh,
    htop = htop,
    btop = btop,
    nvim = nvim,
    make = make,
)

