scratch_test(
    "nvim_aarch64_test",
    nvim,
    "aarch64",
    entry = "/bin/nvim",
    cmd = ["--headless", "--version"],
    expect = "^NVIM v",
    env = "VIMRUNTIME=/share/nvim/runtime",
)

bundle("bundle_aarch64", "aarch64", git, zsh, htop, btop, nvim, make)
