# The node image: a sealed kernel, a tiny initrd, and the devlayer sysroot as
# a read-only EROFS root. The same kernel is a local test target.
#
#   bazel build //node:oci          # vmlinuz + initrd.img as an OCI layout
#   bazel test --config=node //node/...
#
# The kernel build needs a Linux x86_64 exec host. See node/README.md.

load(":defs.bzl", "node_vm_test", "oci_layout")

package(default_visibility = ["//visibility:public"])

[config_setting(
    name = name,
    constraint_values = ["@platforms//os:" + os, "@platforms//cpu:" + cpu],
) for name, os, cpu in [
    ("macos_arm64", "macos", "arm64"),
    ("linux_x86_64", "linux", "x86_64"),
    ("linux_aarch64", "linux", "aarch64"),
]]

# QEMU and its firmware, pinned for each host.
_QEMU = {
    ":macos_arm64": "@node_qemu_macos_arm64",
    ":linux_x86_64": "@node_qemu_linux_x86_64",
    ":linux_aarch64": "@node_qemu_linux_aarch64",
}

[alias(
    name = name,
    actual = select({k: v + "//:" + name for k, v in _QEMU.items()}),
) for name in ["qemu", "qemu-system-x86_64"]]

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

# allnoconfig plus kernel/ser9.config, LLVM=1, no modules. HOSTCC is zig.
genrule(
    name = "kernel",
    srcs = [
        "kernel/ser9.config",
        "@linux_kernel_src//file",
        "@kernel_llvm_linux_amd64//:all",
        "@kernel_llvm_linux_amd64//:bin/clang",
        "@node_hosttools_linux_x86_64//:all",
        "@node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1",
        "@zig_linux_amd64//:all",
        "@zig_linux_amd64//:zig",
    ],
    outs = [
        "vmlinuz",
        "kernel.config",
        "gen_init_cpio",
    ],
    cmd = " ".join([
        "KERNEL_TAR=$(location @linux_kernel_src//file)",
        "LLVM_BIN=$$(dirname $(location @kernel_llvm_linux_amd64//:bin/clang))",
        "HOST_ROOT=$$(dirname $$(dirname $(location @node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1)))",
        "ZIG=$(location @zig_linux_amd64//:zig)",
        "FRAGMENT=$(location kernel/ser9.config)",
        "OUT_BZIMAGE=$(location vmlinuz)",
        "OUT_CONFIG=$(location kernel.config)",
        "OUT_CPIO_TOOL=$(location gen_init_cpio)",
        "sh $(location kernel/build.sh)",
    ]),
    target_compatible_with = _LINUX_X86_64,
    tools = ["kernel/build.sh"],
)

# PID 1, static musl, built by the pinned zig on any host.
genrule(
    name = "init",
    srcs = [
        "init/init.c",
    ] + select({
        ":linux_x86_64": ["@zig_linux_amd64//:all", "@zig_linux_amd64//:zig"],
        ":linux_aarch64": ["@zig_linux_arm64//:all", "@zig_linux_arm64//:zig"],
        ":macos_arm64": ["@zig_darwin_arm64//:all", "@zig_darwin_arm64//:zig"],
    }),
    outs = ["init.bin"],
    cmd = select({
        ":linux_x86_64": "Z=$(location @zig_linux_amd64//:zig)",
        ":linux_aarch64": "Z=$(location @zig_linux_arm64//:zig)",
        ":macos_arm64": "Z=$(location @zig_darwin_arm64//:zig)",
    }) + " && C=$$(mktemp -d) && ZIG_GLOBAL_CACHE_DIR=$$C ZIG_LOCAL_CACHE_DIR=$$C " +
          "$$Z cc -target x86_64-linux-musl -static -Os -s -Wall -Wextra -Werror " +
          "-o $@ $(location init/init.c) && rm -rf $$C",
)

# The devlayer Linux sysroot plus the node pieces, as one read-only EROFS.
genrule(
    name = "sysroot_erofs",
    srcs = [
        "//linux:bundle_x86_64",
        ":init",
        "root/etc/passwd",
        "root/etc/group",
        "@node_hosttools_linux_x86_64//:all",
        "@node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1",
        "@node_hosttools_linux_x86_64//:usr/bin/mkfs.erofs",
    ],
    outs = ["sysroot.erofs"],
    cmd = " ".join([
        "$(location //node/tools/mkimage)",
        "-out $@",
        "-mkfs $(location @node_hosttools_linux_x86_64//:usr/bin/mkfs.erofs)",
        "-loader $(location @node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1)",
        "-libpath $$(dirname $(location @node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1)):$$(dirname $(location @node_hosttools_linux_x86_64//:usr/bin/mkfs.erofs))/../lib",
        "-tar $(location //linux:bundle_x86_64)",
        "-file sbin/init=$(location :init)",
        "-file etc/passwd=$(location root/etc/passwd)",
        "-file etc/group=$(location root/etc/group)",
        "-link bin/sh=../zsh/bin/zsh",
        "-dir dev -dir proc -dir sys -dir run -dir tmp -dir var -dir root -dir etc/node -dir test",
        "-dedupe -z lz4hc",
    ]),
    target_compatible_with = _LINUX_X86_64,
    tools = ["//node/tools/mkimage"],
)

# One uncompressed newc cpio: /init and the EROFS root. gen_init_cpio is the
# kernel's own writer; -t 0 fixes every mtime.
genrule(
    name = "initrd",
    srcs = [
        ":init",
        ":sysroot_erofs",
    ],
    outs = ["initrd.img"],
    cmd = " && ".join([
        "L=$$(mktemp)",
        "printf '%s\\n' 'dir /dev 0755 0 0' 'nod /dev/console 0600 0 0 c 5 1' 'dir /proc 0755 0 0' " +
        "'dir /sys 0755 0 0' 'dir /lower 0755 0 0' 'dir /rw 0755 0 0' 'dir /newroot 0755 0 0' " +
        "\"file /init $(location :init) 0755 0 0\" \"file /sysroot.erofs $(location :sysroot_erofs) 0644 0 0\" > $$L",
        "$(location :gen_init_cpio) -t 0 $$L > $@",
        "rm -f $$L",
    ]),
    target_compatible_with = _LINUX_X86_64,
    tools = [":gen_init_cpio"],
)

# Ready to publish. The shim boots vmlinuz with initrd.img and this cmdline.
oci_layout(
    name = "oci",
    cmdline = "console=tty0 ip=dhcp panic=10",
    layers = {
        ":vmlinuz": "vmlinuz",
        ":initrd": "initrd.img",
    },
    target_compatible_with = _LINUX_X86_64,
    version = "7.2.11-devlayer-ser9",
)

# ─── The node as a test target ──────────────────────────────────────────────

# devlayer's own Go tests, built for linux/amd64 and run as PID 1's payload.
node_vm_test(
    name = "sums_test_vm",
    size = "medium",
    binary = "//internal/sums:sums_test",
    tags = ["node-vm"],
)

node_vm_test(
    name = "versions_test_vm",
    size = "medium",
    binary = "//internal/versions:versions_test",
    tags = ["node-vm"],
)

# The sysroot programs run from the EROFS root on the node kernel.
node_vm_test(
    name = "sysroot_smoke_vm",
    size = "medium",
    binary = "//node/smoke",
    tags = ["node-vm"],
)

# KVM host: /dev/kvm opens and KVM_CREATE_VM works inside the node.
# Needs SVM or VMX in the guest CPU: TCG -cpu max has SVM; KVM needs nested.
node_vm_test(
    name = "kvm_vm",
    size = "medium",
    binary = "//node/kvmcheck",
    tags = ["node-vm"],
)
