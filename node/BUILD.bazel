# The node image: a sealed kernel and a tiny initrd that holds /init and the
# runtime layer (//layers:runtime) as a read-only EROFS root. Nothing else.
# The same kernel is a local test target.
#
#   bazel build //node:oci          # vmlinuz + initrd.img as an OCI layout
#   bazel test --config=node //node/...
#
# The kernel build needs a Linux x86_64 exec host. See node/README.md.

load(":defs.bzl", "node_vm_test", "oci_layout")

package(default_visibility = ["//visibility:public"])

[config_setting(
    name = name,
    constraint_values = ["@platforms//os:" + os, "@platforms//cpu:" + cpu],
) for name, os, cpu in [
    ("macos_arm64", "macos", "arm64"),
    ("linux_x86_64", "linux", "x86_64"),
    ("linux_aarch64", "linux", "aarch64"),
]]

# QEMU and its firmware, pinned for each host.
_QEMU = {
    ":macos_arm64": "@node_qemu_macos_arm64",
    ":linux_x86_64": "@node_qemu_linux_x86_64",
    ":linux_aarch64": "@node_qemu_linux_aarch64",
}

[alias(
    name = name,
    actual = select({k: v + "//:" + name for k, v in _QEMU.items()}),
) for name in ["qemu", "qemu-system-x86_64", "swtpm"]]

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

# allnoconfig plus kernel/ser9.config, LLVM=1, no modules. HOSTCC is zig.
genrule(
    name = "kernel",
    srcs = [
        "kernel/ser9.config",
        "@linux_kernel_src//file",
        "@kernel_llvm_linux_amd64//:all",
        "@kernel_llvm_linux_amd64//:bin/clang",
        "@node_hosttools_linux_x86_64//:all",
        "@node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1",
        "@zig_linux_amd64//:all",
        "@zig_linux_amd64//:zig",
    ],
    outs = [
        "vmlinuz",
        "kernel.config",
        "gen_init_cpio",
    ],
    cmd = " ".join([
        "KERNEL_TAR=$(location @linux_kernel_src//file)",
        "LLVM_BIN=$$(dirname $(location @kernel_llvm_linux_amd64//:bin/clang))",
        "HOST_ROOT=$$(dirname $$(dirname $(location @node_hosttools_linux_x86_64//:lib/ld-musl-x86_64.so.1)))",
        "ZIG=$(location @zig_linux_amd64//:zig)",
        "FRAGMENT=$(location kernel/ser9.config)",
        "OUT_BZIMAGE=$(location vmlinuz)",
        "OUT_CONFIG=$(location kernel.config)",
        "OUT_CPIO_TOOL=$(location gen_init_cpio)",
        "sh $(location kernel/build.sh)",
    ]),
    target_compatible_with = _LINUX_X86_64,
    tools = ["kernel/build.sh"],
)

# PID 1, static musl, built by the pinned zig on any host.
genrule(
    name = "init",
    srcs = [
        "init/init.c",
    ] + select({
        ":linux_x86_64": ["@zig_linux_amd64//:all", "@zig_linux_amd64//:zig"],
        ":linux_aarch64": ["@zig_linux_arm64//:all", "@zig_linux_arm64//:zig"],
        ":macos_arm64": ["@zig_darwin_arm64//:all", "@zig_darwin_arm64//:zig"],
    }),
    outs = ["init.bin"],
    cmd = select({
        ":linux_x86_64": "Z=$(location @zig_linux_amd64//:zig)",
        ":linux_aarch64": "Z=$(location @zig_linux_arm64//:zig)",
        ":macos_arm64": "Z=$(location @zig_darwin_arm64//:zig)",
    }) + " && C=$$(mktemp -d) && ZIG_GLOBAL_CACHE_DIR=$$C ZIG_LOCAL_CACHE_DIR=$$C " +
          "$$Z cc -target x86_64-linux-musl -static -Os -s -Wall -Wextra -Werror " +
          "-o $@ $(location init/init.c) && rm -rf $$C",
)

# One uncompressed newc cpio: /init and the runtime layer. gen_init_cpio is the
# kernel's own writer; -t 0 fixes every mtime.
genrule(
    name = "initrd",
    # gen_init_cpio is a src, not a tool: a tool would build the kernel again
    # in the exec configuration. This target only builds on Linux x86_64.
    srcs = [
        ":gen_init_cpio",
        ":init",
        "//layers:runtime",
    ],
    outs = ["initrd.img"],
    cmd = " && ".join([
        "L=$$(mktemp)",
        "printf '%s\\n' 'dir /dev 0755 0 0' 'nod /dev/console 0600 0 0 c 5 1' 'dir /proc 0755 0 0' " +
        "'dir /sys 0755 0 0' 'dir /lower 0755 0 0' 'dir /rw 0755 0 0' 'dir /newroot 0755 0 0' " +
        "\"file /init $(location :init) 0755 0 0\" \"file /runtime.erofs $(location //layers:runtime) 0644 0 0\" > $$L",
        "$(location :gen_init_cpio) -t 0 $$L > $@",
        "rm -f $$L",
    ]),
    target_compatible_with = _LINUX_X86_64,
)

# Ready to publish. The shim boots vmlinuz with initrd.img and this cmdline.
oci_layout(
    name = "oci",
    cmdline = "console=tty0 ip=dhcp panic=10",
    layers = {
        ":vmlinuz": "vmlinuz",
        ":initrd": "initrd.img",
    },
    target_compatible_with = _LINUX_X86_64,
    version = "7.2.11-devlayer-ser9",
)

# ─── The node as a test target ──────────────────────────────────────────────

# Every test boots the runtime layer only. The payload comes in on its own
# EROFS disk. devlayer's own Go tests: static linux/amd64 binaries.
node_vm_test(
    name = "sums_test_vm",
    size = "medium",
    binary = "//internal/sums:sums_test",
    tags = ["node-vm"],
)

node_vm_test(
    name = "versions_test_vm",
    size = "medium",
    binary = "//internal/versions:versions_test",
    tags = ["node-vm"],
)

# The dev layer (the full devlayer sysroot) attached at /layers/dev: the
# prototype for layering. Its programs run through their devlayer wrappers.
node_vm_test(
    name = "sysroot_smoke_vm",
    size = "medium",
    binary = "//node/smoke",
    layers = {"//layers:dev": "dev"},
    tags = ["node-vm"],
)

# SSH and identity. The guest gets a TPM 2.0 from the pinned swtpm behind
# tpm-crb, the interface of the SER9's AMD fTPM.
#
# Key login, password refused, user and host certificates, host key = TPM key.
node_vm_test(
    name = "ssh_vm",
    size = "medium",
    binary = "//node/sshcheck",
    tags = ["node-vm"],
    tpm = True,
)

# Two boots on one swtpm state dir: the same host key, and no OS state.
node_vm_test(
    name = "identity_tpm_vm",
    size = "medium",
    binary = "//node/sshcheck",
    boots = 2,
    host_key_across_boots = "same",
    tags = ["node-vm"],
    tpm = True,
)

# No TPM: fail closed. sshd is not listening, the FATAL line is on serial.
node_vm_test(
    name = "no_tpm_vm",
    size = "medium",
    binary = "//node/sshcheck",
    cmdline = "node_check=no-tpm",
    expect_serial = "identity: FATAL no TPM 2.0 (/dev/tpmrm0 missing): enable fTPM in BIOS (Security > AMD fTPM). sshd not started",
    tags = ["node-vm"],
)

# The explicit opt-in: a RAM host key, a WARNING, a new key every boot.
node_vm_test(
    name = "ephemeral_vm",
    size = "medium",
    binary = "//node/sshcheck",
    boots = 2,
    cmdline = "node_identity=ephemeral node_check=ephemeral",
    expect_serial = "identity: WARNING node_identity=ephemeral",
    host_key_across_boots = "differ",
    tags = ["node-vm"],
)

# KVM host: /dev/kvm opens and KVM_CREATE_VM works inside the node.
# Needs SVM or VMX in the guest CPU: TCG -cpu max has SVM; KVM needs nested.
node_vm_test(
    name = "kvm_vm",
    size = "medium",
    binary = "//node/kvmcheck",
    tags = ["node-vm"],
)
