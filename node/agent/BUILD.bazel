load("@rules_go//go:def.bzl", "go_binary")

# node-agent: the status banner on the monitor (tty0) and the release
# watcher that reboots into a new boot.penner.network release. See main.go.
go_binary(
    name = "agent",
    srcs = [
        "banner.go",
        "bless.go",
        "efi.go",
        "main.go",
        "nv.go",
        "watch.go",
    ],
    embedsrcs = ["roots.pem"],
    out = "node-agent",
    gc_linkopts = ["-s", "-w"],
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_google_go_tpm//legacy/tpm2",
        "@com_github_google_go_tpm//tpmutil",
        "@org_golang_x_crypto//ssh",
    ],
)
