load("@rules_go//go:def.bzl", "go_test")
load(":defs.bzl", "nvim_musl")

exports_files(
    [
        "host_luajit.sh",
        "host_nlua0.sh",
    ],
    visibility = ["//internal/binaries:__pkg__"],
)

exports_files(
    [
        "defs.bzl",
        "host_cc.sh",
    ],
    visibility = ["//visibility:public"],
)

# Pre-built runtime. Darwin and the non-Linux bundle use this alias.
alias(
    name = "nvim",
    actual = select({
        "//tools:linux_amd64": "@nvim_linux_amd64//:all",
        "//tools:darwin_arm64": "@nvim_darwin_arm64//:all",
    }),
    visibility = ["//visibility:public"],
)

# Static musl nvim. //linux:nvim_* applies the Zig Linux transition.
nvim_musl()

go_test(
    name = "host_cc_test",
    srcs = ["host_cc_test.go"],
    data = ["host_cc.sh"],
)
