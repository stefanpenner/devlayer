load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

# GNU make — built statically, no external dependencies
# Target named "gnumake" to avoid name collision with the "make" binary
# that GNU make produces in its build directory.
configure_make(
    name = "gnumake",
    args = ["-j"],
    # Zig emits a Linux ELF. Configure must not run that ELF on the build machine.
    configure_options = select({
        "//tools:linux_amd64": ["--host=x86_64-unknown-linux-musl"],
        "//tools:linux_arm64": ["--host=aarch64-unknown-linux-musl"],
        # The depfile probe runs the target PE. This host cannot run it.
        "//tools:windows_amd64": ["--host=x86_64-w64-mingw32", "--disable-dependency-tracking"],
        "//tools:windows_arm64": ["--host=aarch64-w64-mingw32", "--disable-dependency-tracking"],
        "//conditions:default": [],
    }),
    env = select({
        "@platforms//os:linux": {
            "CFLAGS": "-Os -DNDEBUG",
            "LDFLAGS": "-static",
        },
        "@platforms//os:windows": {
            "CFLAGS": "-Os -DNDEBUG",
            "LDFLAGS": "-static",
        },
        "@platforms//os:macos": {
            "CFLAGS": "-Os -DNDEBUG",
            "AR": "/usr/bin/ar",
        },
        "//conditions:default": {
            "CFLAGS": "-Os -DNDEBUG",
        },
    }),
    lib_source = "@make_src//:all_srcs",
    out_binaries = select({
        "//tools:is_windows": ["make.exe"],
        "//conditions:default": ["make"],
    }),
    visibility = ["//visibility:public"],
)
