load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

# Zsh — Z shell (built from source)
# Uses release tarball from zsh.org which includes pre-generated configure.
configure_make(
    name = "zsh",
    args = ["-j"],
    configure_command = "devlayer-configure",
    configure_in_place = True,
    configure_options = select({
        "//tools:linux_amd64": ["--host=x86_64-unknown-linux-musl"],
        "//tools:linux_arm64": ["--host=aarch64-unknown-linux-musl"],
        "//conditions:default": [],
    }) + [
        "--with-term-lib=ncursesw",
        "--disable-dynamic",
        "--enable-multibyte",
        "--enable-static",
        "--enable-unicode9",
        "--with-tcsetpgrp",
    ],
    env = select({
        "//tools:is_linux": {
            "CFLAGS": "-Os -DNDEBUG",
            "LDFLAGS": "-static",
        },
        "@platforms//os:macos": {
            "CFLAGS": "-Os -DNDEBUG",
            "AR": "/usr/bin/ar",
        },
        "//conditions:default": {
            "CFLAGS": "-Os -DNDEBUG",
        },
    }),
    deps = ["//third_party/ncurses"],
    lib_source = "@zsh_src//:all_srcs",
    out_binaries = ["zsh"],
    # Zsh installs function files to share/zsh/
    out_data_dirs = ["share"],
    out_shared_libs = [],
    visibility = ["//visibility:public"],
)
