load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

# Static wide ncurses. Fallbacks avoid a host tic binary.
configure_make(
    name = "ncurses",
    configure_options = select({
        "//tools:linux_amd64": ["--host=x86_64-unknown-linux-musl"],
        "//tools:linux_arm64": ["--host=aarch64-unknown-linux-musl"],
        "//conditions:default": [],
    }) + [
        "--disable-db-install",
        "--enable-widec",
        "--without-ada",
        "--without-database",
        "--without-cxx",
        "--without-debug",
        "--without-manpages",
        "--without-progs",
        "--without-shared",
        "--without-tests",
    ],
    env = select({
        "//tools:is_linux": {
            # Empty cache skips the ar probe. A failed probe writes ARFLAGS "unknown".
            "cf_cv_ar_flags": "",
            "CFLAGS": "-Os -DNDEBUG",
            "LDFLAGS": "-static",
        },
        "//conditions:default": {
            "CFLAGS": "-Os -DNDEBUG",
        },
    }),
    lib_source = "@ncurses_src//:all_srcs",
    out_static_libs = ["libncursesw.a"],
    visibility = ["//visibility:public"],
)
