load("//tools:glow.bzl", "offline_go")

# glow — compiled from the pinned tag archive.
offline_go(
    name = "glow_linux_amd64",
    goos = "linux",
    goarch = "amd64",
)

offline_go(
    name = "glow_linux_arm64",
    goos = "linux",
    goarch = "arm64",
)

offline_go(
    name = "glow_darwin_arm64",
    goos = "darwin",
    goarch = "arm64",
)

offline_go(
    name = "glow_windows_amd64",
    goos = "windows",
    goarch = "amd64",
)

alias(
    name = "glow",
    actual = select({
        "//tools:linux_amd64": ":glow_linux_amd64",
        "//tools:linux_arm64": ":glow_linux_arm64",
        "//tools:darwin_arm64": ":glow_darwin_arm64",
    }),
    visibility = ["//visibility:public"],
)
