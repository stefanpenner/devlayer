load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

# The release tarball ships configure. The tag archive does not.
configure_make(
    name = "htop",
    args = ["-j"],
    configure_options = select({
        "//tools:linux_amd64": ["--host=x86_64-unknown-linux-musl"],
        "//tools:linux_arm64": ["--host=aarch64-unknown-linux-musl"],
        "//conditions:default": [],
    }) + [
        "--enable-static",
    ],
    # The install dir must not be named htop. The Makefile removes that path
    # before it links the binary.
    install_prefix = "out",
    deps = ["//third_party/ncurses"],
    env = select({
        "//tools:is_linux": {
            "CFLAGS": "-Os -DNDEBUG",
            "LDFLAGS": "-static",
        },
        "//conditions:default": {
            "CFLAGS": "-Os -DNDEBUG",
        },
    }),
    lib_source = "@htop_src//:all_srcs",
    out_binaries = ["htop"],
    visibility = ["//visibility:public"],
)
